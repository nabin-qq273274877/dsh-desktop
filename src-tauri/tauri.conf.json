{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DSH Desktop",
  "version": "0.1.0",
  "identifier": "com.dsh.desktop",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "",
    "frontendDist": "../src-static"
  },
  "app": {
    "windows": [
      {
        "label": "loading",
        "title": "DSH Desktop",
        "width": 560,
        "height": 420,
        "resizable": false,
        "center": true,
        "decorations": true,
        "visible": true,
        "url": "index.html"
      },
      {
        "label": "main",
        "title": "DeepSeek Harness",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "url": "index.html"
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "resources": {
      "resources/node": "node"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/<OWNER>/<REPO>/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI3NEVCQUY1NkQzQzZDQjgKUldTNGJEeHQ5YnBPdDNVQ3UyZDg4T1ZuaUxvOUY1cFNmVTVjT2x4aVNKQjV2Umw1OXJwbFBPVFcK"
    }
  }
}
