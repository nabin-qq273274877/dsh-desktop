{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepSeek Harness Desktop",
  "version": "0.1.1",
  "identifier": "com.dsh.desktop",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../src-static"
  },
  "app": {
    "windows": [
      {
        "label": "loading",
        "title": "DeepSeek Harness Desktop",
        "width": 560,
        "height": 420,
        "resizable": false,
        "center": true,
        "decorations": true,
        "visible": true,
        "url": "index.html"
      },
      {
        "label": "main",
        "title": "DeepSeek Harness",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "url": "index.html"
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "resources": {
      "resources/node": "node"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installerHooks": "installer.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/nabin-qq273274877/dsh-desktop/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg2Mzg5QTE4OThCMTgwMDUKUldRRmdMR1lHSm80aHF6TzcwaGNYbTJSQ0Q0aldudXdMM0t0eE4xSkEyd0htUVgyTU5IaWllRlYK"
    }
  }
}
